{
  "name": "Mote",
  "scopeName": "source.mote",
  "patterns": [
    {"include": "#comments"},
    {"include": "#strings"},
    {"include": "#numbers"},
    {"include": "#keywords"},
    {"include": "#types"},
    {"include": "#functions"},
    {"include": "#operators"}
  ],
  "repository": {
    "comments": {"patterns": [{"name":"comment.line.double-slash.mote","match":"//.*$"}]},
    "strings": {"patterns": [{"name":"string.quoted.double.mote","begin":"\"","end":"\"","patterns":[{"name":"constant.character.escape.mote","match":"\\\\."}]},{"name":"string.quoted.single.mote","begin":"'","end":"'","patterns":[{"name":"constant.character.escape.mote","match":"\\\\."}]}]},
    "numbers": {"patterns": [{"name":"constant.numeric.mote","match":"\\b\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?\\b"}]},
    "keywords": {"patterns": [{"name":"keyword.control.mote","match":"\\b(?:use|as|pub|fn|let|mut|type|match|case|async|await)\\b"},{"name":"constant.language.mote","match":"\\b(?:true|false|nil)\\b"}]},
    "types": {"patterns": [{"name":"entity.name.type.mote","match":"\\b(?:str|num|bool|unknown|any|never|Result)\\b"},{"name":"entity.name.type.mote","match":"(?<=\\btype\\s+)[A-Za-z_$][A-Za-z0-9_$]*"}]},
    "functions": {"patterns": [{"name":"entity.name.function.mote","match":"(?<=\\bfn\\s+)[A-Za-z_$][A-Za-z0-9_$]*"}]},
    "operators": {"patterns": [{"name":"keyword.operator.mote","match":"==|!=|<=|>=|&&|\\|\\||\\?\\?|->|[+*/%!=<>?:.-]"}]}
  }
}
