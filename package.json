{
  "name": "mote",
  "version": "0.1.0",
  "description": "Mote v0.2 — typed, token-aware language that compiles to readable TypeScript.",
  "type": "module",
  "bin": {
    "mote": "bin/mote.mjs"
  },
  "exports": {
    "./api": "./src/api.mjs",
    "./runtime": "./src/runtime/mote.mjs"
  },
  "files": ["bin", "src", "docs", "examples", "README.md", "LICENSE"],
  "scripts": {
    "test": "node tests/run.mjs && node tests/trust.mjs && node tests/property.mjs --cases 512",
    "bench": "node bench/run.mjs",
    "audit": "node bench/audit.mjs",
    "audit:extended": "node tests/property.mjs --cases 12000 && node bench/audit.mjs",
    "eval": "node eval/run.mjs",
    "verify": "npm test && node tests/cli.mjs && node tests/consumer.mjs && npm run audit && npm run eval"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@lenml/tokenizer-deepseek_v3": "^3.7.2",
    "@lenml/tokenizer-llama3": "^3.7.2",
    "gpt-tokenizer": "^3.4.0"
  }
}
